# Copy to .env.gateway on the gateway host and replace the value below.
# Never commit the populated file.
SOOP_GATEWAY_INGRESS_SECRET=replace-with-the-same-32-plus-character-server-secret

# One browser process is shared, while each renderer shard owns this many
# independent workspace sessions. Set to 1 and restart for page-level isolation.
SOOP_GATEWAY_SESSIONS_PER_SHARD=16
SOOP_GATEWAY_RENDERER_PROCESS_LIMIT=8
