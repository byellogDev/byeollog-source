* text=auto

# Windows entry points and build scripts.
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf
*.sln text eol=crlf
*.csproj text eol=crlf
*.cs text eol=crlf

# Cross-platform source and configuration.
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.ts text eol=lf
*.json text eol=lf
*.sql text eol=lf
*.html text eol=lf
*.css text eol=lf
*.md text eol=lf
PROJECT_HANDOFF_20260825_NEXT_CHAT/*.txt text eol=lf

# Media and release artifacts are byte-preserved when explicitly tracked.
*.png binary
*.gif binary
*.ico binary
*.wav binary
*.mp3 binary
*.zip binary
*.exe binary
