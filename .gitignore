# Repository boundary: the workspace contains historical releases, local
# captures, and recovery output. The first commit intentionally starts from a
# small allowlist; nothing else is moved or deleted by this policy.
/*
!/.gitignore
!/.gitattributes
!/.github/
!/.github/**
!/scripts/
!/scripts/**
!/README.md
!/PROJECT_BASELINE_20260825_KO.md
!/PROJECT_CURRENT_STATUS_20260826_KO.md
!/PUBLIC_RELEASE_READINESS_REPORT_20260825_KO.md
!/BYEOLLOG_SOOP_OAUTH_CALLBACK_DEPLOYMENT_REPORT_20260824_KO.md
!/SOOP_PARTNERSHIP_REAPPLICATION_SUBMISSION_PACK_20260823_KO.md
!/PROJECT_HANDOFF_20260825_NEXT_CHAT/
!/PROJECT_HANDOFF_20260825_NEXT_CHAT/**
!/BYEOLLOG_AGENT_DEV_v07022/
!/BYEOLLOG_AGENT_DEV_v07022/**
!/BYEOLLOG_SERVER_DEV_20260823_SUBSCRIPTION_FIX/
!/BYEOLLOG_SERVER_DEV_20260823_SUBSCRIPTION_FIX/**
!/BYEOLLOG_TTS_SERVICE/
!/BYEOLLOG_TTS_SERVICE/**
!/BYEOLLOG_TTS_RELAY/
!/BYEOLLOG_TTS_RELAY/**

# The allowlisted source trees may still contain local credentials and generated
# distribution files. These patterns protect them during ordinary `git add .`.

# Environment files and local secret material. Keep an explicitly reviewed
# template under a non-.env name (for example, env.example) if one is needed.
.env
.env.*
!.env.example
!.env.sample
*.pfx
*.p12
*.pem
*.key
*.dpapi
*.protected

# Per-machine IDE/build state and deploy-provider state.
.vs/
.vscode/
**/bin/
**/obj/
**/artifacts/
**/ci-artifacts/
**/DIST/
**/publish*/
**/node_modules/
**/.vercel/
**/.wrangler/
**/supabase/.temp/
**/__pycache__/

# Generated release/update packages. Store reviewed release provenance in a
# text manifest instead of committing binaries to this source repository.
*.zip
*.7z
*.rar
*.tar
*.tar.gz
*.exe
*.msi
*.msix
*.msixbundle
*.appx
*.appxbundle
*.nupkg
*.snupkg
**/downloads/

# Local previews, recovery output, tests, captures, and other disposable data.
.tmp*/
tmp/
**/.tmp*/
**/.tmp*
**/tmp/
*.tmp
*.headers
*.sqlite
*.sqlite-shm
*.sqlite-wal

# Historical checkpoints and release exports at the workspace root are not
# canonical source. Their files remain on disk; this only prevents staging.
/RELEASE_*/
/.release-*/
/.deploy_*/
/.obsolete_*/
/output/
**/output/
