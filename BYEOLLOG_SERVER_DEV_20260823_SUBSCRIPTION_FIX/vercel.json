{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["hnd1"],
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/assets/byeollog_app_icon.png",
      "destination": "/api/data?operation=deployment-asset&name=byeollog_app_icon.png"
    },
    {
      "source": "/assets/byeollog_favicon.png",
      "destination": "/api/data?operation=deployment-asset&name=byeollog_favicon.png"
    },
    {
      "source": "/assets/byeollog_logo_dark.png",
      "destination": "/api/data?operation=deployment-asset&name=byeollog_logo_dark.png"
    },
    {
      "source": "/assets/byeollog_logo_light.png",
      "destination": "/api/data?operation=deployment-asset&name=byeollog_logo_light.png"
    },
    {
      "source": "/assets/byeollog_mark.png",
      "destination": "/api/data?operation=deployment-asset&name=byeollog_mark.png"
    },
    {
      "source": "/api/collector-log",
      "destination": "/api/collector?operation=log"
    },
    {
      "source": "/api/inquiry",
      "destination": "/api/login?operation=inquiry"
    },
    {
      "source": "/api/auth/soop/callback",
      "destination": "/api/login?operation=soop-callback"
    },
    {
      "source": "/dashboard",
      "destination": "/api/admin"
    },
    {
      "source": "/agent-rollout",
      "destination": "/api/admin?view=agent-rollout"
    },
    {
      "source": "/roulette-settings",
      "destination": "/api/native-roulette?view=settings"
    },
    {
      "source": "/u/:workspace",
      "destination": "/bangsel_public_workspace_isolation"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; script-src 'self' 'sha256-nmDPzGzRr3JvicqklK69Jn5r+majh5n6CqUQoMPTHso='; script-src-attr 'none'; style-src 'self' 'sha256-KrGRu/DISZDg6R1klGoMax4dN3lBIxNAYJ4OwcPXtkU='; style-src-attr 'none'; img-src 'self'; font-src 'self'; connect-src 'self'; frame-src 'none'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/login",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; script-src-attr 'none'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
        }
      ]
    },
    {
      "source": "/signup",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; script-src-attr 'none'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
        }
      ]
    },
    {
      "source": "/signup-status",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; script-src-attr 'none'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
        }
      ]
    },
    {
      "source": "/reset-password",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; script-src-attr 'none'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
        }
      ]
    },
    {
      "source": "/change-password",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; script-src-attr 'none'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
        }
      ]
    },
    {
      "source": "/withdraw",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; script-src-attr 'none'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
        }
      ]
    },
    {
      "source": "/agent-updates/stable/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=60, must-revalidate"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, noarchive"
        }
      ]
    },
    {
      "source": "/agent-updates/releases/:version/:filename([^/]+\\.zip)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=300"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, noarchive"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/backups?cron=daily",
      "schedule": "0 18 * * *"
    }
  ]
}
