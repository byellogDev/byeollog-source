[Unit]
Description=Byeollog resumable encrypted independent backup
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/byeollog-independent-backup
TimeoutStartSec=2h
Nice=15
CPUQuota=25%
MemoryMax=256M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/byeollog-ops

