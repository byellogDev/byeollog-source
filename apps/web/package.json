{
  "name": "byeollog-web",
  "private": true,
  "version": "0.6.3-g3a.47",
  "byeollogBuild": "0.6.3.67-g3a-agent-release-assets",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "npm run build:public",
    "build:public": "node scripts/build-public-assets.mjs",
    "check:upbo-schema": "node --env-file-if-exists=.env.local tools/Check-UpboSchema.mjs",
    "test:upbo-postgres": "node tools/Test-UpboAtomicPostgres.mjs",
    "validate:runtime": "node --env-file-if-exists=.env.local scripts/validate-runtime-config.mjs",
    "release:manifest": "node scripts/generate-release-manifest.mjs",
    "release:preflight": "npm test && npm run validate:runtime && npm run release:manifest && npm run build:public",
    "release:assets": "node tools/Publish-AgentReleaseAssets.mjs",
    "deploy:production": "node tools/Deploy-Production.mjs",
    "stability:replay": "node tools/Run-StabilityEventReplay.mjs",
    "stability:gate": "node tools/Run-StabilityGate.mjs",
    "stability:smoke": "node tools/Run-ProductionSmoke.mjs --base-url https://byeollog.com",
    "stability:db-pressure": "node tools/Audit-SupabaseRuntimePressure.mjs",
    "lab:roulette": "node tools/Run-NativeRouletteReadinessLab.mjs",
    "twin:roulette": "node tools/Run-NativeRouletteDigitalTwin.mjs",
    "test:roulette-twin": "node tools/Run-NativeRouletteDigitalTwin.mjs --headless --runs 1000 --seed 20260828",
    "benchmark:roulette-tts-local": "node tools/Benchmark-NativeRouletteTtsEndpoint.mjs",
    "benchmark:soop-gateway-browser": "node tools/Benchmark-SoopSharedBrowser.mjs",
    "audit:tts-path": "node tools/Audit-CurrentTtsPath.mjs",
    "benchmark:tts:selftest": "node tools/Benchmark-TtsCandidates.mjs --self-test --iterations 3 --warmups 1 --concurrency 2",
    "benchmark:tts:google": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/Run-GoogleChirpTtsBenchmark.ps1",
    "test:roulette-reliability": "node tools/Simulate-NativeRouletteReliability.mjs --events 10000 --probability-spins 500000 --seed 8272026",
    "audit:roulette-activation": "node tools/Audit-NativeRouletteActivationPrep.mjs",
    "gateway:soop": "node services/soop-chat-gateway/index.mjs",
    "test": "node --test test/*.test.mjs",
    "ui:generate": "node scripts/generate-theme.mjs && node scripts/generate-admin-html.mjs",
    "ui:check": "node scripts/generate-theme.mjs --check && node scripts/generate-admin-html.mjs --check",
    "pretest": "npm run ui:check",
    "prebuild:public": "npm run ui:check"
  },
  "dependencies": {
    "@google-cloud/text-to-speech": "7.0.0",
    "@supabase/supabase-js": "2.57.4",
    "@vercel/functions": "3.4.3",
    "google-auth-library": "11.0.2",
    "sharp": "0.35.4",
    "ws": "8.21.0"
  }
}
