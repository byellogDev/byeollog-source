{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node -e \"console.log(\\\"isolated runtime ready\\\")\"",
  "outputDirectory": "public-dist",
  "regions": [
    "hnd1"
  ],
  "functions": {
    "api/collector.js": {
      "maxDuration": 30
    },
    "api/collector-pair.js": {
      "maxDuration": 30
    },
    "api/upbo-retry.js": {
      "maxDuration": 60
    },
    "api/login.js": {
      "maxDuration": 60
    },
    "api/native-roulette.js": {
      "maxDuration": 30
    }
  },
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, private"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, noarchive"
        },
        {
          "key": "X-Vercel-Enable-Rewrite-Caching",
          "value": "0"
        }
      ]
    }
  ]
}
