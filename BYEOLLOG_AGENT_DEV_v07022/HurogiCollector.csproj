<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>byeollog</AssemblyName>
    <RootNamespace>HurogiCollector</RootNamespace>
    <Version>0.7.0.86</Version>
    <InformationalVersion>0.7.0.86</InformationalVersion>
    <Product>별록 에이전트</Product>
    <AssemblyTitle>별록 에이전트</AssemblyTitle>
    <Description>후원 수집과 별록 액션을 연결하는 별록 에이전트</Description>
    <ApplicationIcon>Assets\byeollog_app.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4022.49" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="AgentStoreTests\**\*.cs" />
  </ItemGroup>

  <!--
    Microsoft.Web.WebView2's shared targets add the WPF wrapper for every
    net5+ managed project, including this WinForms-only app.  The wrapper is
    unused here and brings a second WindowsBase assembly version (MSB3277).
    Remove only that package-injected reference before assembly resolution;
    Core and WinForms references remain unchanged.
  -->
  <Target Name="ExcludeUnusedWebView2WpfReference" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Reference.Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>


  <ItemGroup>
    <EmbeddedResource Include="Assets\byeollog_app.ico" LogicalName="HurogiCollector.Assets.byeollog_app.ico" />
    <EmbeddedResource Include="Assets\byeollog_symbol.png" LogicalName="HurogiCollector.Assets.byeollog_symbol.png" />
    <EmbeddedResource Include="Assets\byeollog_mic_off_overlay.svg" LogicalName="HurogiCollector.Assets.byeollog_mic_off_overlay.svg" />
    <EmbeddedResource Include="Assets\byeollog_mic_off_icon.png" LogicalName="HurogiCollector.Assets.byeollog_mic_off_icon.png" />
    <EmbeddedResource Include="Assets\byeollog_mic_off_badge.png" LogicalName="HurogiCollector.Assets.byeollog_mic_off_badge.png" />
    <EmbeddedResource Include="Assets\byeollog_mic_off_quiet.png" LogicalName="HurogiCollector.Assets.byeollog_mic_off_quiet.png" />
    <EmbeddedResource Include="Assets\byeollog_mic_off_signal_panel.png" LogicalName="HurogiCollector.Assets.byeollog_mic_off_signal_panel.png" />
    <EmbeddedResource Include="Assets\byeollog_mic_off_screenprint.png" LogicalName="HurogiCollector.Assets.byeollog_mic_off_screenprint.png" />
    <EmbeddedResource Include="Assets\byeollog_raffle_ticket_granted.gif" LogicalName="HurogiCollector.Assets.byeollog_raffle_ticket_granted.gif" />
    <EmbeddedResource Include="Assets\byeollog_raffle_draw.gif" LogicalName="HurogiCollector.Assets.byeollog_raffle_draw.gif" />
    <EmbeddedResource Include="Assets\byeollog_flashbang_soft.gif" LogicalName="HurogiCollector.Assets.byeollog_flashbang_soft.gif" />
    <EmbeddedResource Include="Assets\byeollog_flashbang_standard.gif" LogicalName="HurogiCollector.Assets.byeollog_flashbang_standard.gif" />
    <EmbeddedResource Include="Assets\byeollog_flashbang_strong.gif" LogicalName="HurogiCollector.Assets.byeollog_flashbang_strong.gif" />
    <EmbeddedResource Include="Assets\byeollog_raffle_ticket_fixed.wav" LogicalName="HurogiCollector.Assets.byeollog_raffle_ticket_fixed.wav" />
    <EmbeddedResource Include="Assets\byeollog_raffle_winner_fallback.wav" LogicalName="HurogiCollector.Assets.byeollog_raffle_winner_fallback.wav" />
    <EmbeddedResource Include="Ui\byeollog_ui.html" LogicalName="HurogiCollector.Ui.byeollog_ui.html" />
    <EmbeddedResource Include="Ui\agent_automation.html" LogicalName="HurogiCollector.Ui.agent_automation.html" />
    <EmbeddedResource Include="Ui\startup_loading.html" LogicalName="HurogiCollector.Ui.startup_loading.html" />
    <EmbeddedResource Include="Ui\byeollog_logo_dark_safe.png" LogicalName="HurogiCollector.Ui.byeollog_logo_dark_safe.png" />
    <EmbeddedResource Include="Ui\byeollog_logo_light_safe.png" LogicalName="HurogiCollector.Ui.byeollog_logo_light_safe.png" />
    <EmbeddedResource Include="THIRD_PARTY_NOTICES_TTS.txt" LogicalName="HurogiCollector.THIRD_PARTY_NOTICES_TTS.txt" />
    <None Update="Assets\hurogi_balloon.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
