<?xml version="1.0" encoding="utf-8"?>
<Project>
  <!--
    Future standard SDK ClickOnce route.
    This profile is intentionally parameterized and is not the approved-EXE-byte-preserving route.
  -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishProtocol>ClickOnce</PublishProtocol>
    <PublishDir>bin\Release\net8.0-windows\win-x64\clickonce\</PublishDir>
    <PublishUrl>bin\Release\net8.0-windows\win-x64\clickonce\</PublishUrl>
    <InstallUrl>$(ClickOnceBaseUrl)</InstallUrl>
    <UpdateUrl>$(ClickOnceBaseUrl)</UpdateUrl>
    <Install>true</Install>
    <InstallFrom>Web</InstallFrom>
    <UpdateEnabled>true</UpdateEnabled>
    <UpdateMode>Foreground</UpdateMode>
    <UpdateInterval>1</UpdateInterval>
    <UpdateIntervalUnits>Days</UpdateIntervalUnits>
    <UpdateRequired>false</UpdateRequired>
    <MapFileExtensions>true</MapFileExtensions>
    <CreateDesktopShortcut>true</CreateDesktopShortcut>
    <PublisherName>별록</PublisherName>
    <ProductName>별록 에이전트</ProductName>
    <ApplicationVersion>0.7.0.82</ApplicationVersion>
    <ApplicationRevision>13</ApplicationRevision>
    <TargetName>byeollog</TargetName>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <GenerateManifests>true</GenerateManifests>
    <SignManifests>true</SignManifests>
    <ManifestCertificateThumbprint>$(ClickOnceCertificateThumbprint)</ManifestCertificateThumbprint>
    <ManifestTimestampUrl>$(ClickOnceTimestampUrl)</ManifestTimestampUrl>
    <SignAssembly>false</SignAssembly>
    <BootstrapperEnabled>false</BootstrapperEnabled>
    <IsWebBootstrapper>false</IsWebBootstrapper>
    <OpenBrowserOnPublish>false</OpenBrowserOnPublish>
  </PropertyGroup>

  <Target Name="RequireByeollogClickOnceReleaseParameters" BeforeTargets="Publish">
    <Error Condition="'$(ClickOnceBaseUrl)' == ''"
           Text="ClickOnceBaseUrl is required. Pass the final HTTPS base URL with /p:ClickOnceBaseUrl=..." />
    <Error Condition="'$(ClickOnceBaseUrl)' != '' and '$([System.String]::Copy('$(ClickOnceBaseUrl)').ToLowerInvariant().StartsWith('https://'))' != 'True'"
           Text="ClickOnceBaseUrl must use HTTPS." />
    <Error Condition="'$(ClickOnceBaseUrl)' != '' and '$([System.String]::Copy('$(ClickOnceBaseUrl)').EndsWith('/'))' != 'True'"
           Text="ClickOnceBaseUrl must end with a slash." />
    <Error Condition="'$(ClickOnceCertificateThumbprint)' == ''"
           Text="ClickOnceCertificateThumbprint is required. Use a certificate in the Windows personal certificate store." />
    <Error Condition="'$(ClickOnceTimestampUrl)' == ''"
           Text="ClickOnceTimestampUrl is required." />
    <Error Condition="'$(ClickOnceTimestampUrl)' != '' and '$([System.String]::Copy('$(ClickOnceTimestampUrl)').ToLowerInvariant().StartsWith('https://'))' != 'True'"
           Text="ClickOnceTimestampUrl must use HTTPS." />
  </Target>
</Project>
